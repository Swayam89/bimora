# Base path when hosted under a sub-path (GitHub Pages project site). Leave empty for root hosting.
NEXT_PUBLIC_BASE_PATH=

# "mock" uses the built-in demo providers. Switch per service once real clients exist.
NEXT_PUBLIC_SERVICE_MODE=mock

# Future production integrations (server-side only; never expose in NEXT_PUBLIC_*)
GNANI_API_KEY=
DELHIVERY_API_KEY=
PINE_LABS_MERCHANT_ID=
PINE_LABS_API_KEY=
WHATSAPP_BSP_API_KEY=
SMS_PROVIDER_API_KEY=
LLM_API_KEY=
DOCUMENT_AI_API_KEY=
